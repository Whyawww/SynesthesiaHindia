---
interface TimelineItem {
  year: string;
  title: string;
  body: string;
  accent?: boolean;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<section id="timeline" class="relative py-24 bg-hindia-bg overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 relative">
    
    <div
      aria-hidden="true"
      class="absolute left-[35px] md:left-1/2 -translate-x-px top-0 bottom-0 w-[2px]"
      style="background: linear-gradient(to bottom, transparent, var(--color-hindia-subtle) 2%, var(--color-hindia-subtle) 98%, transparent);"
    ></div>

    <div class="flex flex-col gap-12 md:gap-16">
      {items.map((item, i) => (
        <div class={`timeline-item relative grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-12 items-start pl-14 md:pl-0 ${i % 2 === 0 ? '' : 'md:[direction:rtl]'}`}>
          
          <div class={`[direction:ltr] ${i % 2 === 0 ? 'md:text-right' : ''} pt-1`}>
            <span class="label-sm block mb-2 text-hindia-secondary">{item.year}</span>
            <h3 class={`text-2xl font-bold mb-3 ${item.accent ? 'text-hindia-secondary drop-shadow-[0_0_10px_rgba(230,57,70,0.3)]' : 'text-hindia-text'}`}>
              {item.title}
            </h3>
            <p class="text-hindia-muted leading-relaxed text-sm md:text-base">{item.body}</p>
          </div>

          <div
            aria-hidden="true"
            class={`absolute left-[35px] md:left-1/2 top-2 -translate-x-1/2 w-4 h-4 rounded-full border-[3px] z-10 transition-colors duration-300 ${
              item.accent
                ? 'bg-hindia-bg border-hindia-secondary shadow-[0_0_15px_rgba(230,57,70,0.8)]'
                : 'bg-hindia-bg border-hindia-subtle shadow-md'
            }`}
          ></div>

          <div class="hidden md:block"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    document.querySelectorAll<HTMLElement>(".timeline-item").forEach((el, i) => {
      gsap.from(el, {
        scrollTrigger: { trigger: el, start: "top 85%" },
        x: window.innerWidth >= 768 ? (i % 2 === 0 ? -50 : 50) : -30,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
      });
    });
  });
</script>