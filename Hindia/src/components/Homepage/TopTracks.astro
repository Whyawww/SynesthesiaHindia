---
 interface Track {
  id: number;
  title: string;
  artist: string;
  album: string;
  spotify: string;
  ytMusic: string;
  yt: string;
}

const TRACKS: Track[] = [
  {
    id: 1,
    title: "Evakuasi",
    artist: "Hindia",
    album: "Single",
    spotify: "https://open.spotify.com/track/1bcIiU5FWRa2IYBqx0bk67?si=8d3962be5a7d4fde",
    ytMusic: "https://music.youtube.com/watch?v=9t00D7BGTps&si=1V8jMct0q_plsXwF",
    yt: "https://youtu.be/-9qV_tSpS9c?si=2fh8pHce2AEIsqTM",
  },
  {
    id: 2,
    title: "Untuk Apa / Untuk Apa?",
    artist: "Hindia",
    album: "Single",
    spotify: "https://open.spotify.com/track/2LQZ32XuFlkcoEUDSG6BMT?si=e0dc92079e954aa3",
    ytMusic: "https://music.youtube.com/watch?v=ewo4-WTb6OA&si=nWFdsLup0Vupr5qC",
    yt: "https://youtu.be/wCwBwLmPqdY?si=pfvuiTcmBVFQWhpf",
  },
  {
    id: 3,
    title: "Perkara Tubuh",
    artist: "Hindia",
    album: "Lagipula Hidup Akan Berakhir",
    spotify: "https://open.spotify.com/track/6Oqk183RxaZ2fzuAmc7RBY?si=718de2a71fc04798",
    ytMusic: "https://music.youtube.com/watch?v=pVHX0TI9KVM&si=Wv1MCHgVUgzY6Ui3",
    yt: "https://youtu.be/tdFc38AfM-o?si=WttmrCW_zHDSnQnk",
  },
  {
    id: 4,
    title: "letdown",
    artist: "Hindia",
    album: "Doves, '25 on Blank Canvas",
    spotify: "https://open.spotify.com/track/64CqnwntimLdXXIoyMdOXg?si=d587d64e636a4236",
    ytMusic: "https://music.youtube.com/watch?v=D82_hK4MkK4&si=be93crw9QPFxKHQE",
    yt: "https://youtu.be/H3fBa-v56to?si=95vyuS_mf5ba8SY3",
  },
  {
    id: 5,
    title: "Everything U Are",
    artist: "Hindia",
    album: "Doves, '25 on Blank Canvas",
    spotify: "https://open.spotify.com/track/5WOSNVChcadlsCRiqXE45K?si=e4ed73059a094cd6",
    ytMusic: "https://music.youtube.com/watch?v=lB8ASupNtlw&si=y7cu9G13_hx76Vr1",
    yt: "https://youtu.be/lB8ASupNtlw?si=-QWPxckS4RtGX7e-",
  },
];

const tracksJSON = JSON.stringify(TRACKS);
---

<section id="listen" class="relative py-28 overflow-hidden bg-hindia-bg">

  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[400px] rounded-full blur-[140px] opacity-15"
    style="background: radial-gradient(ellipse, var(--color-hindia-secondary), transparent 70%);"
  ></div>

  <div class="relative z-10 max-w-6xl mx-auto px-6">

    <div class="text-center mb-16 tracks-header">
      <p class="label-sm text-hindia-secondary mb-3">Paling Sering Didengar</p>
      <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight text-hindia-text">
        Top Tracks
      </h2>
    </div>

    <!-- Carousel -->
    <div class="relative" id="carousel-root">

      <div
        id="carousel-stage"
        class="relative flex items-center justify-center"
        style="height: 340px; perspective: 1200px;"
        aria-label="Daftar top tracks Hindia"
        role="list"
      >
        {TRACKS.map((track, i) => (
          <article
            class="track-card absolute glass-card cursor-pointer select-none"
            data-index={i}
            role="listitem"
            aria-label={`${track.title} oleh ${track.artist}`}
            tabindex="0"
          >
            <span
              class="track-num block text-6xl font-extrabold leading-none mb-5"
              style="color: var(--color-hindia-subtle);"
            >
              {String(i + 1).padStart(2, '0')}
            </span>

            <div class="flex-1">
              <h3 class="text-hindia-text font-bold text-xl leading-tight mb-1">
                {track.title}
              </h3>
              <p class="text-hindia-muted text-xs font-medium tracking-wide uppercase mb-1">
                {track.artist}
              </p>
              <p class="label-sm">{track.album}</p>
            </div>

            <div
              class="track-accent mt-6 h-0.5 w-8 rounded-full"
              style="background: var(--color-hindia-subtle);"
            ></div>

            <div class="track-cta mt-4 flex items-center gap-2 opacity-0">
              <span class="text-xs font-semibold text-hindia-secondary">Dengarkan</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round"
                class="text-hindia-secondary" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </article>
        ))}
      </div>

      <div class="flex items-center justify-center gap-6 mt-10">

        <button
          id="carousel-prev"
          class="w-11 h-11 flex items-center justify-center rounded-full glass-card text-hindia-muted hover:text-hindia-secondary hover:border-hindia-secondary/40 transition-all duration-300 active:scale-90"
          aria-label="Track sebelumnya"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>

        <div class="flex gap-2" id="carousel-dots" role="tablist" aria-label="Navigasi track">
          {TRACKS.map((_, i) => (
            <button
              class="carousel-dot rounded-full transition-all duration-300"
              data-dot={i}
              role="tab"
              aria-label={`Track ${i + 1}`}
              style="width: 6px; height: 6px; background: var(--color-hindia-subtle);"
            ></button>
          ))}
        </div>

        <button
          id="carousel-next"
          class="w-11 h-11 flex items-center justify-center rounded-full glass-card text-hindia-muted hover:text-hindia-secondary hover:border-hindia-secondary/40 transition-all duration-300 active:scale-90"
          aria-label="Track berikutnya"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>

      <div class="flex justify-center mt-12">
        <a
          href="/diskografi"
          class="group inline-flex items-center gap-3 glass-card px-7 py-3.5 text-sm font-semibold text-hindia-muted hover:text-hindia-text hover:border-hindia-secondary/40 transition-all duration-300 hover:-translate-y-0.5 active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round"
            class="text-hindia-secondary" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <circle cx="12" cy="12" r="3"/>
            <line x1="12" y1="2" x2="12" y2="9"/>
          </svg>
          Lihat Semua Diskografi
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round"
            class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>


<script define:vars={{ tracksJSON }}>
  window.__HINDIA_TRACKS__ = JSON.parse(tracksJSON);
</script>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  interface TrackData {
    id: number; title: string; artist: string; album: string;
    spotify: string; ytMusic: string; yt: string;
  }

  // Constants
  const TOTAL       = 5;
  const CARD_W      = 280;
  const SIDE_OFF    = 240;
  const AUTO_DELAY  = 3000;

  let active      = 0;
  let isAnimating = false;
  let autoTimer: ReturnType<typeof setInterval> | null = null;
  let isPaused    = false;

  const section  = document.querySelector<HTMLElement>("#listen")!;
  const cards    = section.querySelectorAll<HTMLElement>(".track-card");
  const dots     = section.querySelectorAll<HTMLButtonElement>(".carousel-dot");
  const prevBtn  = section.querySelector<HTMLButtonElement>("#carousel-prev");
  const nextBtn  = section.querySelector<HTMLButtonElement>("#carousel-next");
  const stage    = section.querySelector<HTMLElement>("#carousel-stage");

  const mod = (n: number, m: number) => ((n % m) + m) % m;

  const getSlot = (i: number): "center" | "left" | "right" | "hidden" => {
    const rel = mod(i - active, TOTAL);
    if (rel === 0)         return "center";
    if (rel === 1)         return "right";
    if (rel === TOTAL - 1) return "left";
    return "hidden";
  };

  const applyLayout = (animate: boolean) => {
    const dur = animate ? 0.52 : 0;

    cards.forEach((card, i) => {
      const slot      = getSlot(i);
      const isCenter  = slot === "center";
      const isLeft    = slot === "left";
      const isRight   = slot === "right";
      const visible   = isCenter || isLeft || isRight;

      gsap.to(card, {
        x:            isCenter ? 0 : isLeft ? -SIDE_OFF : isRight ? SIDE_OFF : 0,
        scale:        isCenter ? 1 : 0.78,
        opacity:      isCenter ? 1 : visible ? 0.38 : 0,
        rotateY:      isLeft ? 18 : isRight ? -18 : 0,
        duration:     dur,
        ease:         "power3.out",
        zIndex:       isCenter ? 10 : visible ? 5 : 0,
        pointerEvents: isCenter ? "auto" : "none",
        filter:       `blur(${visible && !isCenter ? "2px" : "0px"}) brightness(${isCenter ? 1 : 0.55})`,
      });

      // Nomor warna
      const numEl = card.querySelector<HTMLElement>(".track-num");
      if (numEl) gsap.to(numEl, {
        color: isCenter ? "var(--color-hindia-secondary)" : "var(--color-hindia-subtle)",
        duration: dur, ease: "power2.out",
      });

      // Accent bar
      const accentEl = card.querySelector<HTMLElement>(".track-accent");
      if (accentEl) gsap.to(accentEl, {
        width:      isCenter ? 48 : 32,
        background: isCenter ? "var(--color-hindia-secondary)" : "var(--color-hindia-subtle)",
        duration: dur, ease: "power2.out",
      });

      // CTA
      const ctaEl = card.querySelector<HTMLElement>(".track-cta");
      if (ctaEl) gsap.to(ctaEl, {
        opacity: isCenter ? 1 : 0,
        y:       isCenter ? 0 : 6,
        duration: isCenter ? dur : dur * 0.35,
        ease: "power2.out",
      });
    });

    // Dots
    dots.forEach((dot, i) => {
      const on = i === active;
      gsap.to(dot, {
        width:      on ? 20 : 6,
        background: on ? "var(--color-hindia-secondary)" : "var(--color-hindia-subtle)",
        duration: 0.3, ease: "power2.out",
      });
      dot.setAttribute("aria-selected", String(on));
    });
  };

  const navigate = (dir: 1 | -1) => {
    if (isAnimating) return;
    isAnimating = true;
    active = mod(active + dir, TOTAL);
    applyLayout(true);
    setTimeout(() => { isAnimating = false; }, 580);
  };

  const startAuto = () => {
    if (autoTimer) clearInterval(autoTimer);
    autoTimer = setInterval(() => {
      if (!isPaused) navigate(1);
    }, AUTO_DELAY);
  };

  const pauseAuto  = () => { isPaused = true; };
  const resumeAuto = () => { isPaused = false; };

  section.addEventListener("mouseenter", pauseAuto);
  section.addEventListener("mouseleave", resumeAuto);
  section.addEventListener("focusin",   pauseAuto);
  section.addEventListener("focusout",  resumeAuto);

  window.addEventListener("hindia:modal-opened", pauseAuto);
  window.addEventListener("hindia:modal-closed",  resumeAuto);

  const openModal = () => {
    const tracks = (window as any).__HINDIA_TRACKS__ as TrackData[];
    const track  = tracks[active];
    if (!track) return;
    window.dispatchEvent(new CustomEvent("hindia:open-modal", { detail: track }));
  };

  prevBtn?.addEventListener("click", () => navigate(-1));
  nextBtn?.addEventListener("click", () => navigate(1));

  cards.forEach((card, i) => {
    card.addEventListener("click", () => {
      if (i === active) {
        openModal();
      } else {
        const rel = mod(i - active, TOTAL);
        navigate(rel <= TOTAL / 2 ? 1 : -1);
      }
    });
    card.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        if (i === active) openModal();
      }
    });
  });

  dots.forEach((dot, i) => {
    dot.addEventListener("click", () => {
      if (i === active || isAnimating) return;
      isAnimating = true;
      active = i;
      applyLayout(true);
      setTimeout(() => { isAnimating = false; }, 580);
    });
  });

  let touchX = 0;
  stage?.addEventListener("touchstart", (e) => { touchX = e.touches[0].clientX; }, { passive: true });
  stage?.addEventListener("touchend",   (e) => {
    const diff = touchX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) navigate(diff > 0 ? 1 : -1);
  });

  document.addEventListener("keydown", (e) => {
    const rect = section.getBoundingClientRect();
    if (rect.top >= window.innerHeight || rect.bottom <= 0) return;
    if (e.key === "ArrowRight") navigate(1);
    if (e.key === "ArrowLeft")  navigate(-1);
  });

  cards.forEach((card) => {
    gsap.set(card, { width: CARD_W, padding: "2rem", willChange: "transform, opacity" });
  });

  applyLayout(false);
  startAuto();

  const mm = gsap.matchMedia();
  mm.add("(prefers-reduced-motion: no-preference)", () => {
    gsap.from(".tracks-header > *", {
      scrollTrigger: { trigger: "#listen", start: "top 80%" },
      y: 24, opacity: 0, duration: 0.7, stagger: 0.12, ease: "power3.out",
    });
    gsap.from("#carousel-root", {
      scrollTrigger: { trigger: "#listen", start: "top 72%" },
      y: 40, opacity: 0, duration: 0.9, ease: "power3.out", delay: 0.15,
    });
  });
</script>

<style>
  .track-card {
    transform-style: preserve-3d;
    backface-visibility: hidden;
    will-change: transform, opacity;
  }
</style>