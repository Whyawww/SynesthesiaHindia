---
import { Image } from 'astro:assets';

import imgBas from '../../assets/bas.jpg';
import imgShadow from '../../assets/shadow.jpg';
import imgNyanyi from '../../assets/nyanyi.jpg';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-hindia-bg">
  
  <div class="absolute inset-0 z-0 h-full w-full">
    <Image src={imgBas} alt="Hindia Performance 1" class="hero-img absolute inset-0 h-full w-full object-cover opacity-100 transition-opacity duration-1000 ease-in-out" loading="eager" fetchpriority="high" />
    <Image src={imgShadow} alt="Hindia Performance 2" class="hero-img absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000 ease-in-out" />
    <Image src={imgNyanyi} alt="Hindia Performance 3" class="hero-img absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000 ease-in-out" />
  </div>

  <div class="absolute inset-0 z-10 bg-gradient-to-t from-hindia-bg via-hindia-bg/80 to-transparent"></div>
  <div class="absolute inset-0 z-10 bg-[radial-gradient(circle_at_center,transparent_0%,rgba(15,17,21,0.5)_50%,rgba(15,17,21,1)_100%)]"></div>

  <div class="relative z-20 max-w-7xl mx-auto px-6 w-full text-center flex flex-col items-center gap-8 hero-content">
    
    <div class="flex flex-col gap-4 max-w-4xl animate-fade-up">
      <h1 class="text-6xl md:text-8xl font-sans font-extrabold leading-tight tracking-tighter text-hindia-text selection:bg-hindia-primary">
        Vibes Without <br/> 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-hindia-primary via-hindia-secondary to-hindia-primary bg-300% animate-gradient-pan">Borders</span>
      </h1>
      
      <p class="text-hindia-muted text-base md:text-lg max-w-2xl mx-auto leading-relaxed font-sans">
        Jelajahi setiap bait, makna, dan perjalanan Baskara Putra (Hindia). Musik tanpa batas, murni sebuah koneksi batin.
      </p>
    </div>

    <div class="animate-fade-up animation-delay-300">
      <button id="hero-play-btn" class="font-sans font-semibold text-hindia-bg bg-hindia-secondary hover:bg-hindia-text px-10 py-4 rounded-full transition-all duration-300 shadow-lg hover:shadow-hindia-secondary/30 transform hover:-translate-y-1 active:scale-95 cursor-pointer">
        Mulai Dengarkan
      </button>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";

  const images = gsap.utils.toArray<HTMLImageElement>(".hero-img"); 
  const content = document.querySelector<HTMLElement>(".hero-content");

  if (images.length > 0) {
    let currentIndex = 0;
    const changeImage = () => {
      const nextIndex = (currentIndex + 1) % images.length;
      const currentImg = images[currentIndex];
      const nextImg = images[nextIndex];

      if (currentImg && nextImg) {
        gsap.to(currentImg, { opacity: 0, duration: 1.5, ease: "power2.inOut" });
        gsap.to(nextImg, { opacity: 1, duration: 1.5, ease: "power2.inOut" });
      }
      currentIndex = nextIndex;
    };
    setInterval(changeImage, 5000);
  }

  if (content) {
    gsap.from(content.children, {
      y: 40, opacity: 0, duration: 1, stagger: 0.2, ease: "power3.out", delay: 0.3
    });
  }

  const playBtn = document.querySelector<HTMLButtonElement>("#hero-play-btn");
  
  if (playBtn) {
    playBtn.addEventListener("click", () => {
      const payload = {
        title: "Hindia",
        album: "Eksplorasi karya dan melodi dari Baskara Putra", 
        spotify: "https://open.spotify.com/artist/51kyrUsAVqUBcoDEMFkX12",
        ytMusic: "https://music.youtube.com/@hindia",
        yt: "https://www.youtube.com/@hindia"
      };

      window.dispatchEvent(new CustomEvent("hindia:open-modal", { detail: payload }));
    });
  }
</script>

<style>
  .bg-300\% { background-size: 300% 100%; }
  
  @keyframes gradient-pan {
    0% { background-position: 0% 50%; }
    100% { background-position: 100% 50%; }
  }
  
  .animate-gradient-pan { animation: gradient-pan 8s linear infinite; }
</style>