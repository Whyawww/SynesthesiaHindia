---
import { Image } from 'astro:assets';
import logoHindia from '../assets/hindia.png';

const pathname = Astro.url.pathname;
---

<header class="fixed top-0 left-0 w-full z-50 p-4 md:p-6 transition-all duration-300">
  <nav class="max-w-7xl mx-auto glass-panel px-6 py-3 flex items-center justify-between rounded-full relative z-50">
    
    <a href="/" class="text-xl md:text-2xl font-sans font-bold flex items-center gap-3 group">
      <Image 
        src={logoHindia} 
        alt="Logo Hindia" 
        class="w-9 h-9 rounded-full object-cover border-2 border-transparent group-hover:border-hindia-primary transition-colors duration-300" 
      />
      <div class="flex gap-1">
        <span class="text-hindia-text">Synesthesia</span>
      </div>
    </a>

    <ul class="hidden md:flex items-center gap-8 text-xl font-sans font-bold">
      <li>
        <a href="/" class={`transition-colors duration-300 ${pathname === '/' ? 'text-hindia-secondary' : 'text-hindia-muted hover:text-hindia-text'}`}>
          Home
        </a>
      </li>
      <li>
        <a href="/biografi" class={`transition-colors duration-300 ${pathname.startsWith('/biografi') ? 'text-hindia-secondary' : 'text-hindia-muted hover:text-hindia-text'}`}>
          Biografi
        </a>
      </li>
      <li>
        <a href="/diskografi" class={`transition-colors duration-300 ${pathname.startsWith('/diskografi') ? 'text-hindia-secondary' : 'text-hindia-muted hover:text-hindia-text'}`}>
          Diskografi
        </a>
      </li>
    </ul>

    <div class="hidden md:flex items-center gap-6 text-sm font-sans font-medium">
      <button class="navbar-play-btn bg-hindia-secondary hover:bg-hindia-text text-hindia-bg px-6 py-2 rounded-full transition-all duration-300 shadow-[0_0_15px_rgba(244,162,97,0.3)] hover:shadow-[0_0_20px_rgba(226,232,240,0.5)] transform hover:-translate-y-0.5 cursor-pointer">
        Mulai Dengar
      </button>
    </div>

    <button id="mobile-menu-toggle" class="md:hidden flex items-center justify-center text-hindia-text hover:text-hindia-secondary transition-colors focus:outline-none" aria-label="Toggle Menu">
      <svg id="icon-menu" class="w-7 h-7 block transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      <svg id="icon-close" class="w-7 h-7 hidden transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </nav>

  <div id="mobile-menu" class="absolute top-[80px] left-4 right-4 glass-panel flex-col p-6 opacity-0 pointer-events-none -translate-y-5 transition-all duration-300 md:hidden z-40">
    <ul class="flex flex-col items-center gap-6 text-lg font-sans font-bold pb-6">
      <li>
        <a href="/" class={`transition-colors duration-300 ${pathname === '/' ? 'text-hindia-secondary' : 'text-hindia-muted hover:text-hindia-text'}`}>Home</a>
      </li>
      <li>
        <a href="/biografi" class={`transition-colors duration-300 ${pathname.startsWith('/biografi') ? 'text-hindia-secondary' : 'text-hindia-muted hover:text-hindia-text'}`}>Biografi</a>
      </li>
      <li>
        <a href="/diskografi" class={`transition-colors duration-300 ${pathname.startsWith('/diskografi') ? 'text-hindia-secondary' : 'text-hindia-muted hover:text-hindia-text'}`}>Diskografi</a>
      </li>
    </ul>
    
    <div class="flex justify-center border-t border-white/10 pt-6">
      <button class="navbar-play-btn w-full bg-hindia-secondary hover:bg-hindia-text text-hindia-bg px-6 py-3 rounded-full font-bold transition-all duration-300 shadow-[0_0_15px_rgba(244,162,97,0.3)] cursor-pointer">
        Mulai Dengar
      </button>
    </div>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  let isMenuOpen = false;

  if (menuToggle && mobileMenu && iconMenu && iconClose) {
    menuToggle.addEventListener('click', () => {
      isMenuOpen = !isMenuOpen;
      
      if (isMenuOpen) {
        mobileMenu.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-5');
        mobileMenu.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        iconMenu.classList.replace('block', 'hidden');
        iconClose.classList.replace('hidden', 'block');
      } else {
        mobileMenu.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        mobileMenu.classList.add('opacity-0', 'pointer-events-none', '-translate-y-5');
        iconClose.classList.replace('block', 'hidden');
        iconMenu.classList.replace('hidden', 'block');
      }
    });
  }

  const playBtns = document.querySelectorAll<HTMLButtonElement>('.navbar-play-btn');
  
  playBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const payload = {
        title: "Hindia",
        album: "Eksplorasi karya dan melodi dari Baskara Putra", 
        spotify: "https://open.spotify.com/artist/51kyrUsAVqUBcoDEMFkX12",
        ytMusic: "https://music.youtube.com/@hindia",
        yt: "https://www.youtube.com/@hindia"
      };

      window.dispatchEvent(new CustomEvent("hindia:open-modal", { detail: payload }));
      
      if (isMenuOpen) {
        menuToggle?.click();
      }
    });
  });
</script>