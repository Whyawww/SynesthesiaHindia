---
import { Image } from 'astro:assets';
import modalImg from '../../assets/modal.jpg';
---

<dialog
  id="track-modal"
  class="bg-transparent m-auto p-0 w-[92%] max-w-3xl"
  aria-modal="true"
  aria-labelledby="modal-track-title"
>
  <div
    id="modal-inner"
    class="glass-panel flex flex-col md:flex-row w-full overflow-hidden rounded-2xl relative"
  >

    <button
      id="modal-close"
      class="absolute top-4 right-4 z-50 w-9 h-9 flex items-center justify-center rounded-full glass-card text-hindia-muted hover:text-white hover:border-hindia-secondary/50 transition-all duration-200 active:scale-90"
      aria-label="Tutup modal"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2.5"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>

    <div class="md:w-[42%] h-56 md:h-auto relative flex-shrink-0 overflow-hidden">
      <Image
        src={modalImg}
        alt="Hindia — artwork"
        class="w-full h-full object-cover object-center"
        loading="lazy"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 42vw"
      />
      <div class="absolute inset-0 bg-gradient-to-b md:bg-gradient-to-r from-transparent to-hindia-bg/90"></div>
      <div
        aria-hidden="true"
        class="absolute bottom-0 left-0 w-full h-1/2 pointer-events-none"
        style="background: linear-gradient(to top, rgba(16,170,231,0.08), transparent);"
      ></div>
    </div>

    <div class="flex-1 p-8 md:p-10 flex flex-col justify-center bg-hindia-bg/60 backdrop-blur-xl">

      <p class="label-sm text-hindia-secondary mb-3">Dengarkan Sekarang</p>

      <h3
        id="modal-track-title"
        class="text-2xl md:text-3xl font-extrabold text-hindia-text leading-tight mb-1"
      >—</h3>
      <p id="modal-track-album" class="text-hindia-muted text-sm mb-8">—</p>

      <!-- Platform links -->
      <div class="flex flex-col gap-3">

        <!-- Spotify -->
        <a id="modal-spotify" href="#" target="_blank" rel="noopener noreferrer"
          class="platform-link group flex items-center gap-4 p-4 rounded-xl border transition-all duration-200
                 bg-[#1DB954]/8 hover:bg-[#1DB954]/18 border-[#1DB954]/25 hover:border-[#1DB954]/70">
          <svg class="w-7 h-7 flex-shrink-0 text-[#1DB954]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.84.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.84.241 1.2zM20.16 9.6C15.84 7.08 9.12 6.9 5.281 8.04c-.6.18-1.2-.18-1.38-.72-.18-.6.18-1.2.72-1.38 4.32-1.32 11.76-1.08 16.68 1.86.54.3.72 1.02.42 1.56-.24.54-.9.72-1.56.42z"/>
          </svg>
          <span class="text-hindia-text font-medium text-sm group-hover:translate-x-0.5 transition-transform duration-200">Spotify</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
            class="ml-auto text-hindia-muted group-hover:text-[#1DB954] transition-colors" aria-hidden="true">
            <path d="M7 17 17 7M17 7H7M17 7v10"/>
          </svg>
        </a>

        <!-- YouTube Music -->
        <a id="modal-ytmusic" href="#" target="_blank" rel="noopener noreferrer"
          class="platform-link group flex items-center gap-4 p-4 rounded-xl border transition-all duration-200
                 bg-white/4 hover:bg-white/8 border-white/8 hover:border-white/25">
          <svg class="w-7 h-7 flex-shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="12" fill="#FF0033"/>
            <circle cx="12" cy="12" r="4.5" fill="white"/>
            <circle cx="12" cy="12" r="2" fill="#FF0033"/>
          </svg>
          <span class="text-hindia-text font-medium text-sm group-hover:translate-x-0.5 transition-transform duration-200">YouTube Music</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
            class="ml-auto text-hindia-muted group-hover:text-white transition-colors" aria-hidden="true">
            <path d="M7 17 17 7M17 7H7M17 7v10"/>
          </svg>
        </a>

        <!-- YouTube -->
        <a id="modal-yt" href="#" target="_blank" rel="noopener noreferrer"
          class="platform-link group flex items-center gap-4 p-4 rounded-xl border transition-all duration-200
                 bg-[#FF0000]/8 hover:bg-[#FF0000]/15 border-[#FF0000]/25 hover:border-[#FF0000]/60">
          <svg class="w-7 h-7 flex-shrink-0 text-[#FF0000]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span class="text-hindia-text font-medium text-sm group-hover:translate-x-0.5 transition-transform duration-200">YouTube</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
            class="ml-auto text-hindia-muted group-hover:text-[#FF0000] transition-colors" aria-hidden="true">
            <path d="M7 17 17 7M17 7H7M17 7v10"/>
          </svg>
        </a>

      </div>
    </div>
  </div>
</dialog>

<script>
  import { gsap } from "gsap";

  const modal     = document.querySelector<HTMLDialogElement>("#track-modal");
  const inner     = document.querySelector<HTMLElement>("#modal-inner");
  const closeBtn  = document.querySelector<HTMLButtonElement>("#modal-close");
  const titleEl   = document.querySelector<HTMLElement>("#modal-track-title");
  const albumEl   = document.querySelector<HTMLElement>("#modal-track-album");
  const spotifyEl = document.querySelector<HTMLAnchorElement>("#modal-spotify");
  const ytmusicEl = document.querySelector<HTMLAnchorElement>("#modal-ytmusic");
  const ytEl      = document.querySelector<HTMLAnchorElement>("#modal-yt");

  if (!modal || !inner) {
    console.warn("TrackModal: <dialog> tidak ditemukan. Pastikan <TrackModal /> di-render di index.astro.");
  } else {

    const animateOpen = () => {
      gsap.fromTo(inner,
        { opacity: 0, scale: 0.94, y: 16 },
        { opacity: 1, scale: 1, y: 0, duration: 0.4, ease: "power3.out" }
      );
      gsap.fromTo(inner.querySelectorAll(".platform-link"),
        { opacity: 0, y: 10 },
        { opacity: 1, y: 0, duration: 0.35, stagger: 0.07, ease: "power2.out", delay: 0.15 }
      );
    };

    const animateClose = (cb: () => void) => {
      gsap.to(inner, {
        opacity: 0, scale: 0.96, y: 8,
        duration: 0.22, ease: "power2.in", onComplete: cb,
      });
    };

    const openModal = (track: {
      title: string; album: string;
      spotify: string; ytMusic: string; yt: string;
    }) => {
      if (titleEl)   titleEl.textContent  = track.title;
      if (albumEl)   albumEl.textContent  = track.album;
      if (spotifyEl) spotifyEl.href       = track.spotify;
      if (ytmusicEl) ytmusicEl.href       = track.ytMusic;
      if (ytEl)      ytEl.href            = track.yt;

      modal.showModal();
      document.body.style.overflow = "hidden";
      window.dispatchEvent(new Event("hindia:modal-opened"));
      animateOpen();
    };

    const closeModal = () => {
      animateClose(() => {
        modal.close();
        document.body.style.overflow = "";
        window.dispatchEvent(new Event("hindia:modal-closed"));
      });
    };

    window.addEventListener("hindia:open-modal", (e) => openModal((e as CustomEvent).detail));

    closeBtn?.addEventListener("click", closeModal);

    modal.addEventListener("cancel", (e) => { e.preventDefault(); closeModal(); });

    modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });
  }
</script>

<style>
  #track-modal {
    border: none;
    outline: none;
    overflow: visible;
    background: transparent;
    max-height: 90vh;
  }

  #track-modal::backdrop {
    background: rgba(9, 11, 15, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
</style>